{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jubarte v1 edit plan envelope",
  "$comment": "Operation payload schemas are published by jubarte capabilities --json. This schema validates the plan envelope and settlement policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "author", "operations"],
  "properties": {
    "schema_version": {"const": 1},
    "source_sha256": {"type": ["string", "null"]},
    "author": {"type": "string"},
    "date": {"type": ["string", "null"]},
    "initials": {"type": ["string", "null"]},
    "existing_revisions": {"enum": ["refuse", "accept", "reject", "keep"], "default": "refuse"},
    "removed_anchor_comments": {"type": "string", "enum": ["remove", "keep"], "default": "remove"},
    "resolve_revisions": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "accept": {"$ref": "#/$defs/filter"},
        "reject": {"$ref": "#/$defs/filter"}
      }
    },
    "operations": {"type": "array", "items": {"type": "object"}},
    "update_fields": {"type": "boolean", "default": false},
    "rewrite_others_comments": {"type": "boolean", "default": false},
    "others": {"enum": ["allow", "keep"], "default": "allow"}
  },
  "$defs": {
    "filter": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "ids": {"type": ["array", "null"], "items": {"type": "string"}},
        "authors": {"type": ["array", "null"], "items": {"type": "string"}},
        "kinds": {"type": ["array", "null"], "items": {"enum": ["insertion", "deletion", "move", "formatting"]}}
      }
    }
  }
}
