{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "text_view",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "text_view": {
      "const": "final"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "description",
          "checks"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
            "not": {
              "pattern": "[^A-Za-z0-9_.-]"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "target",
                    "text"
                  ],
                  "properties": {
                    "kind": {
                      "const": "text_equals"
                    },
                    "target": {
                      "$ref": "#/$defs/target"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "description": "Exact final text of one mapped paragraph. Missing, split, merged or ambiguous mapping refuses; missing target is not passing text absence."
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "target",
                    "text"
                  ],
                  "properties": {
                    "kind": {
                      "const": "text_contains"
                    },
                    "target": {
                      "$ref": "#/$defs/target"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "description": "Exact final text of one mapped paragraph. Missing, split, merged or ambiguous mapping refuses; missing target is not passing text absence."
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "target",
                    "text"
                  ],
                  "properties": {
                    "kind": {
                      "const": "text_absent"
                    },
                    "target": {
                      "$ref": "#/$defs/target"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "description": "Exact final text of one mapped paragraph. Missing, split, merged or ambiguous mapping refuses; missing target is not passing text absence."
                }
              ]
            }
          }
        }
      },
      "minItems": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jubarte:expectations-v1:paragraph-text",
  "title": "Jubarte expectations v1 — paragraph text predicates",
  "$comment": "Production library parsing contract, derived from the design artifact docs/design/cli-v2/jubarte-expectations-v1.schema.json; every constraint is the design's. Keys must be unique (compiler check). Empty checks means UNASSESSED, not passed. Apply binds references to original source and evaluates on actual primary bytes. Standalone check requires references/hash for the inspected file. A separate file does not prove independent authorship, legal adequacy, secure redaction or full task completion.",
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "short_id",
        "long_id"
      ],
      "properties": {
        "short_id": {
          "type": "string",
          "minLength": 1
        },
        "long_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Both IDs must identify the SAME entity in the hash-bound original source. This schema validates shape; the compiled ID codec and resolver validate grammar, type and identity. Targets are snapshot-relative. Do not guess either value."
    }
  }
}
