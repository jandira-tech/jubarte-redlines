{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "policy",
    "resolve_revisions",
    "author",
    "date",
    "scope",
    "operations"
  ],
  "properties": {
    "removed_anchor_comments": {
      "type": "string",
      "enum": ["remove", "keep"],
      "default": "remove"
    },
    "rewrite_others_comments": {
      "type": "boolean",
      "default": false
    },
    "others": {
      "type": "string",
      "enum": ["allow", "keep"],
      "default": "allow"
    },
    "schema_version": {
      "const": 2
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track",
        "existing_revisions",
        "text_view"
      ],
      "properties": {
        "track": {
          "enum": [
            "on",
            "off"
          ]
        },
        "existing_revisions": {
          "enum": [
            "keep",
            "accept",
            "reject",
            "refuse"
          ]
        },
        "text_view": {
          "const": "final"
        }
      },
      "description": "Selected decisions run first, then this policy for remaining revisions. Refuse is global: any remaining revision anywhere blocks. Track affects only new edits. Unsupported track-off plus keep combinations must not choose an all-accepted clean copy."
    },
    "resolve_revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accept",
        "reject"
      ],
      "properties": {
        "accept": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          },
          "uniqueItems": true
        },
        "reject": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          },
          "uniqueItems": true
        }
      },
      "description": "Original-source logical revision selections; both move halves are one logical change. Resolve aliases and dependencies before disjointness checks. Selected choices are explicit and never inferred from desired text."
    },
    "author": {
      "type": "string",
      "pattern": "[^\\t-\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:[0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "not": {
        "pattern": "[\\r\\n]"
      },
      "description": "Timezone-bearing timestamp. Production parsing must validate calendar/time/offset values, not rely on a JSON Schema consumer enabling format assertions."
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "all"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "targets"
          ],
          "properties": {
            "kind": {
              "const": "selected"
            },
            "targets": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/target"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      ],
      "description": "Direct content/review-operation scope. Resolve-revisions decisions separately authorize their logical changes/dependencies and NEVER expand body-edit scope. Descendant expansion uses the compiled source model, not guessed ID arithmetic."
    },
    "operations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/rewrite"
          },
          {
            "$ref": "#/$defs/replace"
          },
          {
            "$ref": "#/$defs/delete"
          },
          {
            "$ref": "#/$defs/insert"
          },
          {
            "$ref": "#/$defs/insertParagraph"
          },
          {
            "$ref": "#/$defs/deleteParagraph"
          },
          {
            "$ref": "#/$defs/comment"
          },
          {
            "$ref": "#/$defs/replyComment"
          },
          {
            "$ref": "#/$defs/resolveComment"
          },
          {
            "$ref": "#/$defs/editComment"
          },
          {
            "$ref": "#/$defs/deleteComment"
          }
        ]
      },
      "description": "Typed requests. Empty is valid; review decisions can still change the document. Truly unchanged primary publication normally succeeds with original bytes. No activation field. Source resolution, before hashes, conflicts, preservation and effects require the compiler."
    },
    "source_context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "target",
          "reason_codes"
        ],
        "properties": {
          "kind": {
            "enum": [
              "paragraph",
              "comment",
              "opaque"
            ]
          },
          "target": {
            "$ref": "#/$defs/target"
          },
          "text": {
            "type": "string"
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "paragraph",
                    "comment"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "text"
              ]
            }
          }
        ],
        "description": "Immutable ORIGINAL-source observation in its final logical projection (or original comment body). Original basis is independent of selected decisions. If text is supplied, re-extract and verify it; changed text refuses. Opaque items use a real containing target. Removing observations requests no mutation."
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "traversal_complete",
        "text_complete",
        "eligible_paragraphs",
        "context_paragraphs",
        "opaque_regions"
      ],
      "properties": {
        "traversal_complete": {
          "type": "boolean"
        },
        "text_complete": {
          "type": "boolean"
        },
        "eligible_paragraphs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "conditional_paragraphs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "context_paragraphs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "opaque_regions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      },
      "description": "Generation observations, not permission or task-completion evidence. Conditional paragraphs are a subset of eligible paragraphs. Text completeness concerns represented text; opaque coverage is reported separately. Recompute actual constraints."
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jubarte:edit-plan-v2:text-and-review",
  "$comment": "Production library parsing contract. Source identity, ID grammar/resolution, working hashes, scope and composition require compilation against the bound source. Draft 2020-12 consumers must enable date-time format assertions. The author pattern uses an explicit engine-independent whitespace class (Rust Unicode White_Space union U+FEFF) to match the parser. The date pattern excludes year 0000 and second 60 to match XSD 1.0 dateTime. Coverage and occurrence integer fields add a u64::MAX upper bound to match the Rust u64 type.",
  "title": "Jubarte PlanV2 text-and-review profile",
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "short_id",
        "long_id"
      ],
      "properties": {
        "short_id": {
          "type": "string",
          "minLength": 1
        },
        "long_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Both IDs must identify the SAME entity in the hash-bound original source. This schema validates shape; the compiled ID codec and resolver validate grammar, type and identity. Targets are snapshot-relative. Do not guess either value."
    },
    "attachedComment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "New comment using plan attribution. Anchored to the verified nonempty result of this operation; not an arbitrary future paragraph ID. An unchanged text component does not cancel this comment."
    },
    "rewrite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "before_sha256",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "rewrite"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "before_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "text": {
          "type": "string"
        },
        "attached_comment": {
          "$ref": "#/$defs/attachedComment"
        }
      },
      "description": "Exact desired working paragraph text. Require exact one-to-one original-to-working paragraph correspondence. Verify SHA-256 of UTF-8 exact working text BEFORE removing an unchanged text component. Empty text preserves the paragraph mark. Attached comments remain explicit requests.",
      "allOf": [
        {
          "if": {
            "required": [
              "attached_comment"
            ]
          },
          "then": {
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "replace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "find",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "replace"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "find": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "attached_comment": {
          "$ref": "#/$defs/attachedComment"
        }
      },
      "description": "Count every exact literal start position in working text, including overlaps; require exactly one match without an occurrence. Occurrence indexes that complete start-position list. Empty replacement deletes only the selected text. An attached comment requires a nonempty result.",
      "allOf": [
        {
          "if": {
            "required": [
              "attached_comment"
            ]
          },
          "then": {
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "delete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "find"
      ],
      "properties": {
        "kind": {
          "const": "delete"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "find": {
          "type": "string",
          "minLength": 1
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        }
      },
      "description": "Delete one exactly selected text range; missing find is never whole-paragraph deletion."
    },
    "insert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "insert"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "before_text": {
          "type": "string",
          "minLength": 1
        },
        "after_text": {
          "type": "string",
          "minLength": 1
        },
        "edge": {
          "enum": [
            "start",
            "end"
          ]
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "attached_comment": {
          "$ref": "#/$defs/attachedComment"
        }
      },
      "oneOf": [
        {
          "required": [
            "before_text"
          ]
        },
        {
          "required": [
            "after_text"
          ]
        },
        {
          "required": [
            "edge"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "edge"
            ]
          },
          "then": {
            "not": {
              "required": [
                "occurrence"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "attached_comment"
            ]
          },
          "then": {
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ],
      "description": "Insert nonempty text at exactly one working-text position. Same-position inserts retain array order; intersections with replacement/deletion require the defined ownership rules."
    },
    "insertParagraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "position",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "insert_paragraph"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "position": {
          "enum": [
            "before",
            "after"
          ]
        },
        "text": {
          "type": "string"
        },
        "attached_comment": {
          "$ref": "#/$defs/attachedComment"
        }
      },
      "description": "Insert a paragraph beside an existing original source target in its supported container. Same-side inserts retain array order. Empty paragraphs are meaningful structural insertions.",
      "allOf": [
        {
          "if": {
            "required": [
              "attached_comment"
            ]
          },
          "then": {
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "deleteParagraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target"
      ],
      "properties": {
        "kind": {
          "const": "delete_paragraph"
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      },
      "description": "Explicit structural paragraph deletion. Only faithfully supported tracking/container combinations may execute. Report affected ranges and dependencies."
    },
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "comment"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "find": {
          "type": "string",
          "minLength": 1
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "through": {
          "$ref": "#/$defs/target"
        }
      },
      "allOf": [
        {
          "not": {
            "required": [
              "find",
              "through"
            ]
          }
        },
        {
          "if": {
            "required": [
              "occurrence"
            ]
          },
          "then": {
            "required": [
              "find"
            ]
          }
        }
      ],
      "description": "A new comment on a working-source paragraph, literal range, or same-story paragraph range. Every paragraph covered by through must be within direct scope. Map the range through composition; never silently detach it if its content disappears."
    },
    "replyComment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "reply_comment"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Reply to an existing original-source comment that survives settlement. Sibling replies retain array order. Preserve thread state unless this transaction explicitly requests a final state."
    },
    "resolveComment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "done"
      ],
      "properties": {
        "kind": {
          "const": "resolve_comment"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "done": {
          "type": "boolean"
        }
      },
      "description": "One explicit final state per thread. It may follow replies in the semantic execution order; array order does not determine state. Unknown/removed targets refuse."
    },
    "editComment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "edit_comment"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Replace an existing comment body while preserving its recorded attribution. Duplicate mutation of the same comment or conflict with deletion refuses."
    },
    "deleteComment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "include_replies"
      ],
      "properties": {
        "kind": {
          "const": "delete_comment"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "include_replies": {
          "type": "boolean"
        }
      },
      "description": "Explicit comment removal. Root removal with replies requires include_replies true. Conflicting mutations/replies/state changes on the affected comment/thread refuse."
    }
  }
}
