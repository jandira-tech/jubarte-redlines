+    ("e", "2s", "Accept"),
+    ("e", "ms", "Accept"),
+    ("e", "ns", "Accept"),
+    ("e", "ss", "Accept"),
+    ("ee", "1s", "Accept"),
+    ("ee", "2s", "Accept"),
+    ("ee", "ms", "Accept"),
