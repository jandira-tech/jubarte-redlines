+/// The container-final paragraph that `r` places a block after, if any.
+fn appended_final(tx: &Transaction<'_>, r: &Resolved) -> Option<usize> {
+    let (Resolved::InsertParagraph {
+        anchor,
+        side: Side::After,
+        ..
+    }
