+            r#"<w:pPr><w:rPr><w:{kind} w:id="{}" w:author="Ana" w:date="2026-10-23T00:00:00Z"/></w:rPr></w:pPr>"#,
+            text.bytes().map(u32::from).sum::<u32>()
+        )
+    });
+    format!("<w:p>{mark}<w:r><w:t>{text}</w:t></w:r></w:p>")
+}
