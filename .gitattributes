# The results files name their sample by sha256: no line-end rewriting.
release_info/** -text

# The text fixtures and goldens are read by the tests as LF documents:
# byte comparisons and line splits (agent-view goldens, round-trip pairs,
# patches) must not see a CRLF checkout. `tests/fixtures/from-docx` has its
# own rules. Word documents and other binaries are never rewritten.
tests/fixtures/**/*.md text eol=lf
tests/fixtures/**/*.txt text eol=lf
tests/fixtures/**/*.json text eol=lf
tests/fixtures/**/*.yaml text eol=lf
tests/fixtures/**/*.yml text eol=lf
tests/fixtures/**/*.docx binary
# The schema the consistency tests parse (tests/schema_consistency.rs).
tests/data/wml_main_schema.json text eol=lf
