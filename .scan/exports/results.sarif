            "confidence": "high",
            "findingId": "csf_7bd64146a8b40f28ac601665",
            "occurrenceId": "occ_35e95662f64ddf279240040f",
            "severity": "medium"
          },
          "ruleId": "inspect-format-span-prefix-complexity",
          "ruleIndex": 22
        },
