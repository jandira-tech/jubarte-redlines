            "confidence": "high",
            "findingId": "csf_5722c422d8b3b400072d52fe",
            "occurrenceId": "occ_919955b08cd68e024b9c5cc8",
            "severity": "low"
          },
          "ruleId": "predictable-plan-staging-symlink",
          "ruleIndex": 31
        },
