+  const plan = path.join(tmp, "staging.json");
+  const result = runWithPlanHook(plan, (fs, mock, assert, plan) => {
+    const opens = [];
+    const open = fs.openSync;
+    mock.method(fs, "openSync", (name, ...args) => {
+      opens.push([String(name), ...args]);
+      return open(name, ...args);
+    });
