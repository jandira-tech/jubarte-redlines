+mod wmf_record_boundary_tests {
+    //! A record's handlers read only the record's own payload. A short
+    //! record that reaches into the next record's bytes turns a tiny
+    //! metafile into unbounded text retention and geometry work, because
+    //! the outer loop revisits those bytes as part of later records too.
+    use super::*;
+
+    fn placeable() -> Vec<u8> {
+        let mut d = vec![0u8; 22];
+        d[0..4].copy_from_slice(&PLACEABLE_KEY);
+        for (i, v) in [0_i16, 0, 100, 100].iter().enumerate() {
+            d[6 + 2 * i..8 + 2 * i].copy_from_slice(&v.to_le_bytes());
+        }
+        d[14..16].copy_from_slice(&1440u16.to_le_bytes());
+        d.extend_from_slice(&vec![0u8; 18]); // WMF header, no objects
+        d
+    }
+
+    /// A record as raw bytes, with the size the document declares for it —
+    /// not the size of `body`.
+    fn raw_record(d: &mut Vec<u8>, size_words: u32, func: u16, body: &[u8]) {
+        d.extend_from_slice(&size_words.to_le_bytes());
+        d.extend_from_slice(&func.to_le_bytes());
+        d.extend_from_slice(body);
+    }
+
+    /// A well-formed `META_EXTTEXTOUT` at (0, 0) carrying `text`.
+    fn ext_textout(d: &mut Vec<u8>, text: &[u8]) {
+        let mut body = Vec::with_capacity(8 + text.len());
+        body.extend_from_slice(&0i16.to_le_bytes()); // y
+        body.extend_from_slice(&0i16.to_le_bytes()); // x
+        body.extend_from_slice(&(text.len() as u16).to_le_bytes()); // count
+        body.extend_from_slice(&0u16.to_le_bytes()); // options
+        body.extend_from_slice(text);
+        if body.len() % 2 == 1 {
+            body.push(0);
+        }
+        raw_record(d, (3 + body.len() / 2) as u32, 0x0A32, &body);
+    }
+
+    #[test]
+    fn a_short_exttextout_cannot_borrow_the_next_records_bytes() {
+        // A six-byte EXTTEXTOUT (no payload of its own) followed by an
+        // unknown record: the old reader consumed the filler's header as
+        // this record's fields, read its function word 0xFFFF as a count of
+        // 65535 and retained the whole file tail as one owned string. The
+        // record's own extent holds none of that, so the file is refused.
+        let mut d = placeable();
+        let filler = vec![b'A'; 70_000];
+        raw_record(&mut d, 3, 0x0A32, &[]);
+        raw_record(&mut d, (3 + filler.len() / 2) as u32, 0xFFFF, &filler);
+        raw_record(&mut d, 3, 0x0000, &[]); // EOF
+        assert!(
+            render(&d).is_none(),
+            "a record short of its own fields is refused, not replayed against borrowed bytes"
+        );
+    }
+
+    #[test]
+    fn a_metafile_of_nothing_but_text_stops_at_the_text_budget() {
+        // Every record is well formed and carries its own 65535 bytes; the
+        // cumulative decoded-text budget stops replay at 16 strings
+        // (16 x 65535 <= 1 MiB < 17 x 65535).
+        let mut d = placeable();
+        for _ in 0..20 {
+            ext_textout(&mut d, &[b'x'; 65_535]);
+        }
+        raw_record(&mut d, 3, 0x0000, &[]); // EOF
+        let (_, _, _, texts) = render(&d).expect("well-formed records render");
+        assert_eq!(texts.len(), 16, "replay stops at the text budget");
+        assert_eq!(texts[0].text.len(), 65_535);
+    }
+}
