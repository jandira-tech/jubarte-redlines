+fn a_redaction_that_survives_in_a_utf16_xml_part_is_refused() {
+    // A BOM-marked UTF-16 XML part is admitted (admission transcodes it to
+    // check it; Word opens it), so the redaction check must read it the
+    // same way instead of certifying output that still carries the text.
+    let source = docx(&para("Account 12345678 is closed."));
+    let mut pkg = PartFs::open(&source).unwrap();
+    let mut utf16 = vec![0xFF, 0xFE];
+    utf16.extend(
+        "<metadata><note>12345678</note></metadata>"
+            .encode_utf16()
+            .flat_map(u16::to_le_bytes),
+    );
+    pkg.set_part("customXml/item1.xml", utf16);
+    pkg.add_content_type_override("/customXml/item1.xml", "application/xml");
+    let doc = pkg.to_zip().unwrap();
+    let e = apply_plan(
+        &doc,
+        &plan(r#"{"kind":"redact","paragraph":"p0","find":"12345678"}"#),
+    )
+    .unwrap_err();
+    assert_eq!(e.code, "REDACTION_LEAK");
+    assert!(e.message.contains("customXml/item1.xml"), "{}", e.message);
+}
