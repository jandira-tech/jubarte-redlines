diff --git a/jubarte-python/tests/test_cli.py b/jubarte-python/tests/test_cli.py
index 62469a0..71db44d 100644
--- a/jubarte-python/tests/test_cli.py
+++ b/jubarte-python/tests/test_cli.py
@@ -32,6 +32,47 @@ def letter(tmp_path: Path) -> Path:
     return path
 
 
+def test_plan_recording_never_writes_through_a_preplanted_partial(
+    letter: Path, tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    """A predictable staging name could be preplanted as a symlink in a
+    directory another account writes; the recording write used to follow it
+    and truncate the file it named. Staging is exclusive and unpredictable
+    now, so the preplanted link is never touched and the plan still lands."""
+    plan = tmp_path / "plan.json"
+    victim = tmp_path / "victim.txt"
+    victim.write_text("do not touch", encoding="utf-8")
+    preplanted = tmp_path / f".plan.json.{os.getpid()}.partial"
+    try:
+        preplanted.symlink_to(victim)
+    except OSError:
+        pytest.skip("this account cannot create symlinks")
+    assert (
+        main(
+            [
+                "edit",
+                str(letter),
+                "--plan",
+                str(plan),
+                "-p",
+                "p1",
+                "--anchor",
+                "individual",
+                "--content",
+                "Changed.",
+            ]
+        )
+        == 0
+    )
+    assert preplanted.is_symlink(), "the preplanted link is never written through"
+    assert victim.read_text(encoding="utf-8") == "do not touch"
+    assert plan.is_file()
+    # The preplanted link itself remains, untouched, above; nothing the
+    # recording staged may remain beside it.
+    leftovers = [p for p in tmp_path.glob(".*.partial") if p != preplanted]
+    assert not leftovers, f"no staging file is left behind: {leftovers}"
+
+
