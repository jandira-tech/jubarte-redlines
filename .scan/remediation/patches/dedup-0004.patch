+fn default_scrub_removes_properties_under_relationship_named_parts() {
+    let source = relocated_properties_document();
+    assert_word_valid_package(&source);
+    let out = scrub(&source, &ScrubOptions::default()).unwrap();
+    assert_word_valid_package(&out);
+    let bytes = all_bytes(&out);
+    for gone in [
+        "Jane Secret",
+        "Secret Corp",
+        "2026-01-02T00:00:00Z",
+        "<cp:revision>",
+    ] {
+        assert!(!contains(&bytes, gone), "{gone:?} survives under a renamed part");
+    }
