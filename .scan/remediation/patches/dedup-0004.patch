+/// The distinct internal package-relationship targets of `rel_type`, in
+/// package order: the parts the package actually names as `rel_type`
+/// property parts, wherever they live. OPC makes the relationship — not a
+/// conventional path — authoritative, so a document can keep its core
+/// properties at `metadata/deal.xml` and a scrub that only looked at
+/// `docProps/core.xml` would leave every identifying field in place.
+fn property_parts(pkg: &PartFs, rel_type: &str) -> Vec<String> {
+    let mut out = Vec::new();
+    for rel in &pkg.package_relationships().items {
+        if rel.rel_type != rel_type || rel.target_mode.as_deref() == Some("External") {
+            continue;
+        }
+        let target = pkg.resolve_rel_target("", &rel.target);
+        if !out.contains(&target) {
+            out.push(target);
+        }
+    }
+    out
 }
 
+/// `known` plus the parts the package reaches through `rel_type` (and the
+/// conventional `known` name itself, for a package whose relationships are
+/// missing or partial).
+fn all_property_parts(pkg: &PartFs, rel_type: &str, known: &str) -> Vec<String> {
+    let mut out = vec![known.to_string()];
+    for part in property_parts(pkg, rel_type) {
+        if !out.contains(&part) {
+            out.push(part);
+        }
+    }
+    out
+}
