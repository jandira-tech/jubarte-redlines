+#[cfg(test)]
+#[cfg_attr(all(coverage_nightly, test), coverage(off))]
+mod opaque_construct_and_nesting_cap_tests {
+    use super::*;
+
+    /// Depth of the deepest element under `node`, iteratively: the inputs
+    /// here are deep enough that a recursive walk would defeat the cap.
+    fn depth_of(dom: &Dom, node: NodeId) -> usize {
+        let mut deepest = 0usize;
+        let mut stack = vec![(node, 0usize)];
+        while let Some((node, level)) = stack.pop() {
+            deepest = deepest.max(level);
+            for i in 0..dom.child_count(node) {
+                stack.push((dom.child_at(node, i), level + 1));
+            }
+        }
+        deepest
+    }
+
+    #[test]
+    fn a_quoted_dtd_literal_hides_no_elements() {
+        // The `>` inside the quoted entity value does not end the DOCTYPE:
+        // the construct is skipped whole (internal subset included), so the
+        // markup hidden inside it never becomes deeply nested elements the
+        // depth gates never saw. An unbound prefix resolves to its local
+        // name (`w:document` is stored as `document` in no namespace).
+        let xml = "<!DOCTYPE a [<!ENTITY x \"<a><a><a>\">]><w:document/>";
+        let mut dom = Dom::new();
+        let doc = parse_xdocument(&mut dom, xml);
+        let root = dom.root(doc).expect("one root");
+        assert!(dom.name_is(root, &crate::xmllinq::XName::get("document", "")));
+        assert_eq!(depth_of(&dom, doc), 1, "one root under the document");
+    }
+
+    #[test]
+    fn a_top_level_cdata_section_is_skipped_whole() {
+        let xml = "<![CDATA[<a><a><a>]]><w:document/>";
+        let mut dom = Dom::new();
+        let doc = parse_xdocument(&mut dom, xml);
+        let root = dom.root(doc).expect("one root");
+        assert!(dom.name_is(root, &crate::xmllinq::XName::get("document", "")));
+        assert_eq!(depth_of(&dom, doc), 1, "one root under the document");
+    }
+
+    #[test]
+    fn unadmitted_xml_stops_at_the_dom_nesting_cap() {
+        // Fifty thousand nested elements exhaust the stack without the cap
+        // (a process abort, a WASM trap); the permissive parser stops
+        // descending at MAX_DOM_NESTING whatever checked gate the input
+        // skipped, and keeps every shallower document byte-identical.
+        let deep = format!("{}{}", "<a>".repeat(50_000), "</a>".repeat(50_000));
+        let mut dom = Dom::new();
+        let doc = parse_xdocument(&mut dom, &deep);
+        assert!(
+            depth_of(&dom, doc) <= MAX_DOM_NESTING,
+            "the DOM must not nest past {MAX_DOM_NESTING}"
+        );
+        let ordinary = format!("{}{}", "<b>".repeat(100), "</b>".repeat(100));
+        let mut dom = Dom::new();
+        let doc = parse_xdocument(&mut dom, &ordinary);
+        assert_eq!(depth_of(&dom, doc), 100, "100 nested elements under the document");
+    }
+}
