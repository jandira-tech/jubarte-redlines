+
+/// Character offsets of byte boundaries in a text, advancing monotonically:
+/// [`merge_spans`] asks for each span's start then end, in text order.
+struct CharCount<'a> {
+    text: &'a str,
+    pos: usize,
+    count: usize,
+}
+
+impl<'a> CharCount<'a> {
+    fn new(text: &'a str) -> Self {
+        Self {
+            text,
+            pos: 0,
+            count: 0,
+        }
+    }
+
+    /// The character offset of byte `byte`, never rescanning what the
+    /// previous call already counted.
+    fn at(&mut self, byte: usize) -> usize {
+        while self.pos < byte {
+            match self.text[self.pos..].chars().next() {
+                Some(c) => {
+                    self.pos += c.len_utf8();
+                    self.count += 1;
+                }
+                None => break,
+            }
+        }
+        self.count
+    }
 }
 
