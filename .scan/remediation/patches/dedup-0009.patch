+/// The text every `redact` operation of a plan removes. A neighbouring
+/// operation resolves against the untouched source, so its report fields
+/// can quote the words a redact removes from the same paragraph: every
+/// outcome is blocked against these needles once the whole plan is
+/// resolved, keeping the documents and the report equally free of them.
+fn redact_needles(operations: &[Operation]) -> Vec<&str> {
+    operations
+        .iter()
+        .filter_map(|operation| match &operation.kind {
+            OperationKind::Redact { find, .. } => Some(find.as_str()),
+            _ => None,
+        })
+        .filter(|find| !find.is_empty())
+        .collect()
+}
+
+/// `text` with every needle occurrence replaced by the block form
+/// [`redaction`] leaves in the documents.
+fn block_redacted_text(text: String, needles: &[&str]) -> String {
+    let mut out = text;
+    for &needle in needles {
+        if out.contains(needle) {
+            out = out.replace(needle, &redaction(needle));
+        }
+    }
+    out
+}
+
+/// Remove every redaction needle an outcome can carry: the source context
+/// and anchor echo of a neighbouring operation, its note, and the
+/// near-match passages a refusal quotes. An occurrence that holds a needle
+/// in escaped form only is dropped whole: shown() can spell characters a
+/// needle spells literally.
+fn scrub_redacted_text(outcome: &mut EditOutcome, needles: &[&str]) {
+    outcome.context = outcome
+        .context
+        .take()
+        .map(|context| block_redacted_text(context, needles));
+    outcome.anchor_given = outcome
+        .anchor_given
+        .take()
+        .map(|anchor| block_redacted_text(anchor, needles));
+    outcome.anchor_read_as = outcome
+        .anchor_read_as
+        .take()
+        .map(|anchor| block_redacted_text(anchor, needles));
+    outcome.message = outcome
+        .message
+        .take()
+        .map(|message| block_redacted_text(message, needles));
+    if let Some(near) = &mut outcome.near {
+        for hit in &mut near.occurrences {
+            if needles.iter().any(|&needle| hit.text.contains(needle)) {
+                hit.text = "{redacted}".into();
+                hit.shown = "{redacted}".into();
+            } else {
+                hit.shown = block_redacted_text(std::mem::take(&mut hit.shown), needles);
+            }
+        }
+    }
+}
