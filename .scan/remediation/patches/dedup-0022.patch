+    #[test]
+    fn list_prefix_scan_stays_linear() {
+        // Pathological input: 60,000 digits then 30,000 `1.` pairs. The
+        // pre-fix decision re-read the whole digit prefix at every
+        // delimiter — about 1.8 billion character examinations for this
+        // input — while the single pass with the running all-digits flag
+        // examines each character exactly once.
+        let digits = 60_000;
+        let pairs = 30_000;
+        let mut text = "7".repeat(digits);
+        text.push('.');
+        text.push_str(&"1.".repeat(pairs - 1));
+        let chars = text.chars().count();
+        let delimiters = text.chars().filter(|&c| matches!(c, '.' | ')')).count();
+        assert_eq!(delimiters, pairs);
+        LIST_PREFIX_STEPS.with(|steps| steps.set(0));
+        let escaped = escape_line(&text);
+        let steps = LIST_PREFIX_STEPS.with(std::cell::Cell::get);
+        // Linear-time bound: a small constant times the text length. The
+        // pre-fix prefix re-scan is Θ(digits × delimiters), which dwarfs
+        // any linear bound by ~4 orders of magnitude.
+        const C: usize = 4;
+        let bound = C * chars;
+        assert!(
+            steps <= bound,
+            "escaping {delimiters} delimiters examined {steps} characters; \
+             a single pass examines at most {bound}"
+        );
+        // The escapes themselves are unchanged: only the first delimiter
+        // follows a pure digit run.
+        let expected = format!("{}\\.{}", "7".repeat(digits), "1.".repeat(pairs - 1));
+        assert_eq!(escaped, expected);
+    }
