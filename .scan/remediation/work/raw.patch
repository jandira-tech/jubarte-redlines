+test("record staging and direct outputs never follow a symlink", () => {
+  const paras = JSON.parse(run("read", untracked, "--json").out).paragraphs;
+  const file = copy(untracked, "stage.docx");
+  const plan = path.join(tmp, "stage-plan.json");
+  // The predictable partial the recorder used to write, pre-placed as a
+  // symlink to a file it must never touch: staging is now created
+  // exclusively under a name nobody can pre-place.
+  const victim = path.join(tmp, "stage-victim.txt");
+  fs.writeFileSync(victim, "do not touch");
+  fs.symlinkSync(victim, path.join(tmp, `.stage-plan.json.${process.pid}.partial`));
+  const recorded = run("edit", file, "--plan", plan, "-p", `p${paras[0].index}`, "--content", "Changed.");
+  assert.equal(recorded.code, 0, recorded.err);
+  assert.equal(fs.readFileSync(victim, "utf8"), "do not touch");
+  assert.equal(JSON.parse(fs.readFileSync(plan, "utf8")).operations.length, 1);
+  assert.deepEqual(fs.readdirSync(tmp).filter((n) => n.endsWith(".partial")), []);
+  // An output written over a symlink replaces the link, never its target,
+  // as the binary's publisher does.
+  const out = path.join(tmp, "stage-link-out.docx");
+  fs.symlinkSync(victim, out);
+  const converted = run("convert", file, "-o", out, "--force");
+  assert.equal(converted.code, 0, converted.err);
+  assert.ok(!fs.lstatSync(out).isSymbolicLink());
+  assert.equal(fs.readFileSync(victim, "utf8"), "do not touch");
+});
