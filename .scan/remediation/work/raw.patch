+/// `leaks` builds a DOM over every XML part it scans, and the permissive
+/// parser recurses per element: a part nested past the depth policy
+/// overflows the stack instead of returning, for any nonempty needle —
+/// even one absent from the part. The scan must admit each part the way
+/// the package reader does and fail closed, as it does for an unreadable
+/// entry (#645's contract).
+#[test]
+fn leaks_fail_closed_on_xml_past_the_scan_depth_budget() {
+    let deep = format!("{}text{}", "<a>".repeat(300), "</a>".repeat(300));
+    let docx = package(|writer, options| {
+        writer.start_file("word/deep.xml", options).unwrap();
+        writer.write_all(deep.as_bytes()).unwrap();
+    });
+    let found = jubarte::scrub::leaks(&docx, "no-such-text-occurs-here");
+    assert_eq!(
+        found,
+        [format!(
+            "word/deep.xml (INVALID_XML: word/deep.xml: XML nests deeper than 256)"
+        )],
+        "a part past the depth budget fails closed"
+    );
+}
