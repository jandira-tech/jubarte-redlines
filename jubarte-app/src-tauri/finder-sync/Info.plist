<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Finder Sync extension's Info.plist. scripts/build-finder-sync.sh
     writes the app's version into both version keys (App Store Connect
     refuses an extension whose version differs from its app's). -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>Jubarte</string>
  <key>CFBundleExecutable</key>
  <string>JubarteFinder</string>
  <key>CFBundleIdentifier</key>
  <string>com.jandira.jubarte.finder</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>JubarteFinder</string>
  <key>CFBundlePackageType</key>
  <string>XPC!</string>
  <key>CFBundleShortVersionString</key>
  <string>@VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@VERSION@</string>
  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>
  <key>NSHumanReadableCopyright</key>
  <string>© 2026 Jandira Technologies, LLC</string>
  <key>NSExtension</key>
  <dict>
    <key>NSExtensionAttributes</key>
    <dict/>
    <key>NSExtensionPointIdentifier</key>
    <string>com.apple.FinderSync</string>
    <key>NSExtensionPrincipalClass</key>
    <string>FinderSync</string>
  </dict>
</dict>
</plist>
