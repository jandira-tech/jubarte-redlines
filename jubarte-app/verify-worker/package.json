{
  "name": "jubarte-verify-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "wrangler types && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply jubarte-entitlements --local",
    "db:migrate:remote": "wrangler d1 migrations apply jubarte-entitlements --remote"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "hono": "^4.13.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260930.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.144.0"
  }
}
