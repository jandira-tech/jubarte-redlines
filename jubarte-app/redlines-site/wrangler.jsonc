{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jubarte-redlines-site",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": { "enabled": true },

  // The old free redline tool's hosts, each a custom domain of this Worker,
  // which answers every request with a 301 to jubarte.pro (src/index.ts).
  // jubarte.pro's own Worker (../jubarte-site) must never list one of them:
  // two Workers claiming a domain take it from each other on every deploy, and
  // jubarte-site/test/node/domains.test.ts fails if they do.
  "routes": [
    { "pattern": "redlines.free", "custom_domain": true },
    { "pattern": "www.redlines.free", "custom_domain": true },
    { "pattern": "redlines.jubarte.pro", "custom_domain": true },
    { "pattern": "redlines.arthur.law", "custom_domain": true }
  ]
}
