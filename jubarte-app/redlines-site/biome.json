{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": ["src/**", "test/**", "scripts/**", "vitest.config.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 92
  },
  "linter": {
    "enabled": true
  },
  "assist": {
    "actions": { "source": { "organizeImports": "on" } }
  }
}
