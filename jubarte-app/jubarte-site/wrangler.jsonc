{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jubarte-site",
  "main": "src/index.ts",
  // The newest date the test pool's workerd supports (vitest-pool-workers 0.22),
  // so the tests run the Worker exactly as production does.
  "compatibility_date": "2026-08-22",
  // No public *.workers.dev copy of the site; jubarte.pro is the only host.
  "workers_dev": false,
  "preview_urls": false,
  // jubarte.pro is attached to this Worker as a custom domain (Cloudflare
  // dashboard, 2026). `wrangler deploy` replaces the Worker's custom-domain set
  // with what this file declares, so it must be listed here or the next deploy
  // detaches it and removes its DNS record. The zone route stays alongside it.
  // www.jubarte.pro serves the same site; every page still names jubarte.pro
  // (canonical links, og:url). The old redline tool's hosts (redlines.free and
  // the rest) belong to ../redlines-site, which redirects them here.
  "routes": [
    { "pattern": "jubarte.pro", "custom_domain": true },
    { "pattern": "www.jubarte.pro", "custom_domain": true },
    { "pattern": "jubarte.pro/*", "zone_name": "jubarte.pro" }
  ],

  // The site is static: `pnpm build` writes public/ (pages, css, js, fonts,
  // the jubarte-wasm builds, pdf.js) and `pnpm fixtures:render` adds
  // the Cases page images and their data. Documents dropped on /demo never reach
  // this Worker — the engine runs as wasm in the visitor's tab.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker sees page requests only, and rate-limits them. Files a page
    // pulls in (styles, scripts, fonts, wasm, case images, data) go straight to
    // the asset server: free, cached, and never counted — one page view fetches
    // well over ten of them, so limiting those would break the first visit.
    "run_worker_first": [
      "/*",
      "!/static/*",
      "!/vendor/*",
      "!/fixtures/*",
      "!/data/*",
      "!/favicon.svg",
      "!/favicon-32.png",
      "!/apple-touch-icon.png",
      "!/og.png",
      "!/robots.txt",
      "!/sitemap.xml"
    ]
  },

  // At most 60 requests a minute per client IP reach the Worker; the rest get a
  // 429 page. Counters are per Cloudflare location, so the cap is approximate by
  // design (it is a cost guard, not an accounting system).
  "ratelimits": [
    {
      "name": "PAGE_LIMIT",
      // Account-wide id: 1001 is also Live Contracts' MCP limiter, which would share counters.
      "namespace_id": "4102",
      "simple": { "limit": 60, "period": 60 }
    }
  ],

  // wrangler dev otherwise hands the Worker the route's host (jubarte.pro) with
  // the local http scheme, and the https upgrade would loop. A local host is
  // never upgraded (src/site.ts).
  "dev": { "host": "localhost" },

  "observability": { "enabled": true }
}
