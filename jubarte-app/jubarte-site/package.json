{
  "name": "jubarte-site",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "test": "pnpm run build && vitest run",
    "test:coverage": "pnpm run build && vitest run --coverage",
    "typecheck": "wrangler types && tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.client.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "release": "scripts/release.sh",
    "bench:check": "node scripts/check-bench.ts",
    "fixtures:stage": "uv run scripts/site_fixtures.py stage",
    "fixtures:upload": "uv run scripts/site_fixtures.py upload",
    "fixtures:fetch": "uv run scripts/site_fixtures.py fetch",
    "fixtures:render": "uv run scripts/site_fixtures.py render"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.3",
    "@vitest/coverage-istanbul": "^4.1.11",
    "jubarte-wasm": "0.11.2",
    "pdfjs-dist": "^6.3.289",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.144.0"
  }
}
