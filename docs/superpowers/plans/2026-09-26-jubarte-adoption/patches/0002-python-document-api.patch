@@ -0,0 +1,5 @@
+# SPDX-FileCopyrightText: 2026 Jandira Technologies, LLC
+# SPDX-License-Identifier: AGPL-3.0-only
+[pytest]
+markers =
+    integration: installed native library, filesystem or environment integration
