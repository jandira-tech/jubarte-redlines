+            Op::StrokeRect {
+                x: 100.0,
+                y: 50.0,
+                w: 40.0,
+                h: 20.0,
+                width: 1.0,
+                color: [0.0; 3],
+            },
+            Op::FillPoly {
+                points: vec![(150.0, 10.0), (190.0, 10.0), (170.0, 40.0)],
+                color: [0.0, 1.0, 0.0],
+            },
+            Op::StrokePoly {
+                points: vec![(150.0, 50.0), (190.0, 50.0), (170.0, 90.0)],
+                width: 1.0,
+                color: [0.0; 3],
+            },
+            Op::FillPath {
