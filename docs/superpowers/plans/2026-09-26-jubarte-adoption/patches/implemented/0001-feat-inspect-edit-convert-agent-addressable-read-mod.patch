++      }
++      return call(() => engine.compareDocuments(original, modified, settings.author));
++    },
++    accept(document) { bytes(document); return call(() => engine.acceptRevisions(document)); },
++    reject(document) { bytes(document); return call(() => engine.rejectRevisions(document)); },
++    revisions(document) { bytes(document); return decodeRevisions(call(() => engine.getRevisions(document))); },
++  });
++}
++
++export function createApi(engine) {
++  return Object.freeze({
