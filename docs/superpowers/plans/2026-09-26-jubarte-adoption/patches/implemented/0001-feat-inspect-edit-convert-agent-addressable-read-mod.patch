++/** Handwritten facade: never edit generated wasm-bindgen files. */
++export class JubarteApiError extends Error {
++  constructor(code, message, cause) {
++    super(message, { cause });
++    this.name = "JubarteApiError";
++    this.code = code;
++  }
++}
++
