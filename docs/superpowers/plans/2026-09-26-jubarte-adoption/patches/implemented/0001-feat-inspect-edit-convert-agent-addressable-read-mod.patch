++  let rows;
++  try { rows = JSON.parse(payload); }
++  catch (cause) { throw new JubarteApiError("REVISION_SCHEMA", "engine returned invalid revision JSON", cause); }
++  schema(Array.isArray(rows), "revision result must be an array");
++  return Object.freeze(rows.map((row) => {
++    schema(row !== null && typeof row === "object" && !Array.isArray(row), "revision must be an object");
++    schema(["Inserted", "Deleted", "Moved", "FormatChanged"].includes(row.type), "unknown revision kind");
++    for (const field of ["author", "date", "part", "text"]) {
++      schema(typeof row[field] === "string", `revision ${field} must be a string`);
++    }
++    schema(row.moveGroupId === null || Number.isSafeInteger(row.moveGroupId), "invalid moveGroupId");
++    schema(row.isMoveSource === null || typeof row.isMoveSource === "boolean", "invalid isMoveSource");
++    let formatChange = null;
++    if (row.formatChange !== null) {
++      const properties = row.formatChange?.changedProperties;
++      schema(Array.isArray(properties) && properties.every(value => typeof value === "string"), "invalid formatChange");
++      formatChange = Object.freeze({ changedProperties: Object.freeze([...properties]) });
++    }
++    return Object.freeze({
++      kind: row.type, author: row.author, date: row.date, part: row.part, text: row.text,
++      moveGroupId: row.moveGroupId, isMoveSource: row.isMoveSource, formatChange,
++    });
++  }));
++}
++
++export function createCompareApi(engine) {
++  return Object.freeze({
++    compare(original, modified, settings) {
++      bytes(original); bytes(modified);
++      options(settings, ["author"]);
