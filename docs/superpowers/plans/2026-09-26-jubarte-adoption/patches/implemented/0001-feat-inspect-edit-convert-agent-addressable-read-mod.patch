++// SPDX-FileCopyrightText: 2026 Jandira Technologies, LLC
++//
++// SPDX-License-Identifier: AGPL-3.0-only
++
++//! Conservative read-only views. Body paragraph order is XML document order,
++//! including table cells, not rendered page order. Text boxes are separate
++//! stories and are omitted; this API is not an all-stories text dump.
++//!
++//! Text reflects the visible run projection (paragraph deletion marks are not coalesced): deleted and moved-from content is
++//! omitted. Tabs and line breaks remain `\t` and `\n`; explicit page breaks set
++//! `page_break`. Field results are included; field instructions are omitted.
++//! Strict namespaces are normalized in memory only. Unsupported alternative or
++//! externally supplied body content returns an error instead of guessed text.
++
++use std::collections::BTreeSet;
++use std::fmt;
++
++use crate::namespaces::{MC, W};
++use crate::opc::PartFs;
++use crate::xmllinq::{Dom, NodeId};
++
++/// One body paragraph with visible run text; indices are valid only for this snapshot.
++#[derive(Clone, Debug, PartialEq, Eq)]
++pub struct ParagraphInfo {
++    /// Zero-based body paragraph index, including table-cell paragraphs.
++    pub index: usize,
++    /// Text with explicit tabs/newlines, excluding text-box stories.
++    pub text: String,
++    /// Whether this paragraph contains a visible explicit page-break element.
++    pub page_break: bool,
++}
++
++/// An invalid package or content whose visible projection is unsupported.
++#[derive(Clone, Debug, PartialEq, Eq)]
++pub enum InspectError {
++    /// OPC/ZIP load failure.
++    Package(String),
++    /// Missing main document part or body.
++    MissingDocument,
++    /// Invalid XML, encoding, or setting value, including the part name.
++    Invalid(String),
++    /// A construct for which this API cannot promise a visible projection.
++    Unsupported(String),
++}
++
++impl fmt::Display for InspectError {
++    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
++        match self {
++            Self::Package(message) => write!(f, "opening DOCX: {message}"),
++            Self::MissingDocument => f.write_str("DOCX has no main document part or body"),
++            Self::Invalid(message) => write!(f, "invalid DOCX content: {message}"),
++            Self::Unsupported(message) => write!(f, "unsupported inspection content: {message}"),
++        }
++    }
++}
++
++impl std::error::Error for InspectError {}
++
++/// Package facts. Counts are XML facts, not rendered-page facts.
++#[derive(Clone, Debug, Default, PartialEq, Eq)]
++pub struct Summary {
++    /// Body paragraphs with visible run text, excluding text boxes.
++    pub paragraphs: usize,
++    /// Comment definitions in the related comments part.
++    pub comments: usize,
++    /// Raw revision carrier elements across XML parts, not coalesced changes.
++    pub revisions: usize,
++    /// Footnote definitions excluding separator and continuation-separator notes.
++    pub footnotes: usize,
++    /// Endnote definitions excluding separator and continuation-separator notes.
++    pub endnotes: usize,
++    /// Distinct internally related header parts.
++    pub headers: usize,
++    /// Distinct internally related footer parts.
++    pub footers: usize,
++    /// Parts whose declared content type starts with `image/`.
++    pub images: usize,
++    /// Body table elements (raw XML, including nested tables).
++    pub tables: usize,
++    /// Body simple fields plus complex-field begin markers (raw XML).
++    pub fields: usize,
++    /// Body section-property elements, excluding saved revision properties.
++    pub sections: usize,
++    /// Body or paragraph-style numbering declarations exist. This does not
++    /// establish that every paragraph, or even a used style, is numbered.
++    pub list_numbering: bool,
++    /// Related settings part explicitly enables tracking new revisions.
++    pub track_changes: bool,
++}
++
++/// Read body paragraphs using the documented conservative final-text view.
++pub fn paragraphs(docx: &[u8]) -> Result<Vec<ParagraphInfo>, InspectError> {
++    let pkg = open(docx)?;
++    let main = main_part(&pkg)?;
++    let (dom, root) = parse_part(&pkg, &main)?;
++    let body = dom
++        .element(root, &W::body())
++        .ok_or(InspectError::MissingDocument)?;
++    body_paragraphs(&dom, body)
++}
++
++/// Inspect once per XML part, with namespace-aware counts and OPC relationships.
++/// The function never converts failed inspection into a zero revision count.
++pub fn summary(docx: &[u8]) -> Result<Summary, InspectError> {
++    let pkg = open(docx)?;
++    let main = main_part(&pkg)?;
++    let (dom, root) = parse_part(&pkg, &main)?;
++    let body = dom
++        .element(root, &W::body())
++        .ok_or(InspectError::MissingDocument)?;
++    let mut summary = Summary {
++        paragraphs: body_paragraphs(&dom, body)?.len(),
++        tables: dom.descendants(body, Some(&W::name("tbl"))).len(),
++        fields: dom.descendants(body, Some(&W::name("fldSimple"))).len()
++            + dom
++                .descendants(body, Some(&W::name("fldChar")))
++                .iter()
++                .filter(|&&node| dom.attribute(node, &W::name("fldCharType")) == Some("begin"))
++                .count(),
++        sections: dom
++            .descendants(body, Some(&W::name("sectPr")))
++            .iter()
++            .filter(|&&node| {
++                !has_ancestor(&dom, node, "sectPrChange") && !has_ancestor(&dom, node, "pPrChange")
++            })
++            .count(),
++        list_numbering: !dom.descendants(body, Some(&W::name("numPr"))).is_empty(),
++        ..Summary::default()
++    };
++    for name in pkg.parts() {
++        if pkg
++            .content_type_for(&name)
++            .is_some_and(|mime| mime.starts_with("image/"))
++        {
++            summary.images += 1;
++        }
++        if name.ends_with(".xml") {
++            let (part_dom, part_root) = parse_part(&pkg, &name)?;
++            summary.revisions += revision_count(&part_dom, part_root);
++        }
++    }
++    let related = |kind: &str| -> BTreeSet<String> {
++        pkg.read_rels_for(&main)
++            .into_iter()
++            .flat_map(|rels| &rels.items)
++            .filter(|rel| {
++                rel.target_mode.as_deref() != Some("External")
++                    && rel.rel_type.rsplit('/').next() == Some(kind)
++            })
++            .map(|rel| pkg.resolve_rel_target(&main, &rel.target))
++            .collect()
++    };
++    for (kind, targets) in [
++        ("header", related("header")),
++        ("footer", related("footer")),
++        ("comments", related("comments")),
++        ("footnotes", related("footnotes")),
++        ("endnotes", related("endnotes")),
++        ("settings", related("settings")),
++        ("styles", related("styles")),
++    ] {
++        for target in targets {
++            let (part_dom, part_root) = parse_part(&pkg, &target)?;
++            match kind {
++                "header" => summary.headers += 1,
++                "footer" => summary.footers += 1,
++                "comments" => {
++                    summary.comments += part_dom.descendants(part_root, Some(&W::comment())).len()
++                }
++                "footnotes" => summary.footnotes += note_count(&part_dom, part_root, "footnote"),
++                "endnotes" => summary.endnotes += note_count(&part_dom, part_root, "endnote"),
++                "styles" => {
++                    for style in part_dom.descendants(part_root, Some(&W::name("style"))) {
++                        if part_dom.attribute(style, &W::name("type")) == Some("paragraph")
++                            && !part_dom
++                                .descendants(style, Some(&W::name("numPr")))
++                                .is_empty()
++                        {
++                            summary.list_numbering = true;
++                        }
++                    }
++                }
++                "settings" => {
++                    if let Some(setting) = part_dom.element(part_root, &W::name("trackRevisions")) {
++                        summary.track_changes = match part_dom.attribute(setting, &W::val()) {
++                            None | Some("true" | "1" | "on") => true,
++                            Some("false" | "0" | "off") => false,
++                            Some(value) => {
++                                return Err(InspectError::Invalid(format!(
++                                    "{target}: invalid trackRevisions value {value}"
++                                )));
++                            }
++                        };
++                    }
++                }
++                _ => unreachable!("enumerated relationship kind"),
++            }
++        }
++    }
++    Ok(summary)
++}
++
++fn open(bytes: &[u8]) -> Result<PartFs, InspectError> {
++    let normalized = crate::strict_translation::strict_to_transitional_docx(bytes);
++    PartFs::open(&normalized).map_err(|error| InspectError::Package(error.to_string()))
++}
++
++fn main_part(pkg: &PartFs) -> Result<String, InspectError> {
++    pkg.main_document_part()
++        .or_else(|| {
++            pkg.part_bytes("word/document.xml")
++                .map(|_| "word/document.xml".to_string())
++        })
++        .ok_or(InspectError::MissingDocument)
++}
++
++fn parse_part(pkg: &PartFs, name: &str) -> Result<(Dom, NodeId), InspectError> {
++    let bytes = pkg
++        .part_bytes(name)
++        .ok_or_else(|| InspectError::Invalid(format!("missing related part {name}")))?;
++    let xml = std::str::from_utf8(bytes)
++        .map_err(|error| InspectError::Invalid(format!("{name}: {error}")))?;
++    crate::xmllinq::parse::validate_xml(xml)
++        .map_err(|error| InspectError::Invalid(format!("{name}: {error}")))?;
++    let mut dom = Dom::new();
++    let document = dom.parse_xdocument(xml);
++    let root = dom
++        .root(document)
++        .ok_or_else(|| InspectError::Invalid(format!("{name}: missing XML root")))?;
++    Ok((dom, root))
++}
++
++fn has_ancestor(dom: &Dom, node: NodeId, local: &str) -> bool {
++    dom.ancestors(node, None)
++        .iter()
++        .any(|&ancestor| dom.name_is(ancestor, &W::name(local)))
++}
++
++fn hidden(dom: &Dom, node: NodeId) -> bool {
++    has_ancestor(dom, node, "del") || has_ancestor(dom, node, "moveFrom")
++}
++
++fn body_paragraphs(dom: &Dom, body: NodeId) -> Result<Vec<ParagraphInfo>, InspectError> {
++    for node in dom.descendants(body, None) {
++        if ["altChunk", "subDoc", "contentPart"]
++            .iter()
++            .any(|local| dom.name_is(node, &W::name(local)))
++            || dom.name_is(node, &MC::name("AlternateContent"))
++        {
++            return Err(InspectError::Unsupported(
++                dom.name(node).map_or_else(String::new, |name| name.clark()),
++            ));
++        }
++    }
++    let mut paragraphs = Vec::new();
++    for paragraph in dom.descendants(body, Some(&W::p())) {
++        if hidden(dom, paragraph) || has_ancestor(dom, paragraph, "txbxContent") {
++            continue;
++        }
++        let mut text = String::new();
++        let mut page_break = false;
++        for node in dom.descendants(paragraph, None) {
++            // Only the closest owning paragraph contributes text. A text-box
++            // paragraph must not leak into both its anchor and its own row.
++            let owner = dom.ancestors(node, Some(&W::p())).first().copied();
++            if owner != Some(paragraph) || hidden(dom, node) {
++                continue;
++            }
++            if dom.name_is(node, &W::t()) {
++                for child in dom.nodes(node) {
++                    if let Some(value) = dom.text_value(child) {
++                        text.push_str(value);
++                    }
++                }
++            } else if dom.name_is(node, &W::name("tab")) {
++                text.push('\t');
++            } else if dom.name_is(node, &W::name("cr")) {
++                text.push('\n');
++            } else if dom.name_is(node, &W::name("br")) {
++                match dom.attribute(node, &W::name("type")) {
++                    Some("page") => page_break = true,
++                    Some("column") => {
++                        return Err(InspectError::Unsupported(
++                            "column break text projection".to_string(),
++                        ));
++                    }
++                    _ => text.push('\n'),
++                }
++            } else if dom.name_is(node, &W::name("noBreakHyphen")) {
++                text.push('\u{2011}');
++            } else if dom.name_is(node, &W::name("softHyphen")) {
++                text.push('\u{00ad}');
++            } else if dom.name_is(node, &W::name("sym")) {
++                return Err(InspectError::Unsupported(
++                    "font-dependent symbol text projection".to_string(),
++                ));
++            }
++        }
++        paragraphs.push(ParagraphInfo {
++            index: paragraphs.len(),
++            text,
++            page_break,
++        });
++    }
++    Ok(paragraphs)
++}
++
++fn note_count(dom: &Dom, root: NodeId, local: &str) -> usize {
++    dom.descendants(root, Some(&W::name(local)))
++        .iter()
++        .filter(|&&node| {
++            !matches!(
++                dom.attribute(node, &W::name("type")),
++                Some("separator" | "continuationSeparator")
++            )
++        })
++        .count()
++}
++
++fn revision_count(dom: &Dom, root: NodeId) -> usize {
++    const CARRIERS: &[&str] = &[
++        "ins",
++        "del",
++        "moveFrom",
++        "moveTo",
++        "rPrChange",
++        "pPrChange",
++        "sectPrChange",
++        "tblPrChange",
++        "tblGridChange",
++        "trPrChange",
++        "tcPrChange",
++        "numberingChange",
++        "cellIns",
++        "cellDel",
++        "cellMerge",
++    ];
++    dom.descendants_and_self(root, None)
++        .iter()
++        .filter(|&&node| {
++            dom.name(node).is_some_and(|name| {
++                name.namespace_name() == W::URI && CARRIERS.contains(&name.local_name())
++            })
++        })
++        .count()
++}
