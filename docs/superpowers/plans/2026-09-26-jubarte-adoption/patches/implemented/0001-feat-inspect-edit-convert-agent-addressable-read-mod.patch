++  }
++  return value;
++}
++
++function call(operation) {
++  try { return operation(); }
++  catch (cause) {
++    throw new JubarteApiError("ENGINE_FAILURE", String(cause instanceof Error ? cause.message : cause), cause);
++  }
++}
++
++function options(value, keys) {
