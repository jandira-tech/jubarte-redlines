+    }
+
+    #[test]
+    fn summary_resolves_nonstandard_related_names_and_prefixes() {
+        let settings = format!(
+            "<s:settings xmlns:s='{}'><s:trackRevisions s:val='on' /></s:settings>",
+            W::URI
+        );
+        let comments = format!(
+            "<s:comments xmlns:s='{}'><s:comment s:id='0'/></s:comments>",
