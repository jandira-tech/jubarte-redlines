+        );
+        let notes = format!(
+            "<s:footnotes xmlns:s='{}'><s:footnote s:type='separator'/><s:footnote s:id='1'/></s:footnotes>",
+            W::URI
+        );
+        let header = format!(
+            "<s:hdr xmlns:s='{}'><s:p><s:ins s:id='1'><s:r><s:t>new</s:t></s:r></s:ins></s:p></s:hdr>",
