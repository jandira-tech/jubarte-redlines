+                ("word/meta/options.xml", &settings),
+                ("word/notes/comment-data.xml", &comments),
+                ("word/notes/definitions.xml", &notes),
+                ("word/chrome/top.xml", &header),
+                ("custom/image.png", "image"),
+            ],
+            rels,
+        );
+        let facts = summary(&docx).unwrap();
+        assert_eq!(
+            (
+                facts.paragraphs,
+                facts.comments,
+                facts.footnotes,
+                facts.headers
+            ),
+            (1, 1, 1, 1)
+        );
+        assert_eq!((facts.images, facts.sections, facts.revisions), (1, 1, 2));
+        assert!(facts.track_changes);
+    }
+
+    #[test]
+    fn inspection_reports_unsupported_and_invalid_content() {
+        assert!(paragraphs(b"not zip").is_err());
+        let alternative = package("<x:altChunk/>", &[], "");
+        assert!(matches!(
+            paragraphs(&alternative),
+            Err(InspectError::Unsupported(_))
+        ));
+        let malformed = package("<x:p", &[], "");
+        assert!(matches!(
+            paragraphs(&malformed),
+            Err(InspectError::Invalid(_))
+        ));
+        let broken_rel = package(
+            "<x:p/>",
+            &[],
+            "<Relationship Id='h' Type='http://schemas.openxmlformats.org/officeDocument/2006/relationships/header' Target='missing.xml'/>",
+        );
+        assert!(matches!(
+            summary(&broken_rel),
+            Err(InspectError::Invalid(_))
+        ));
+    }
+
+    #[test]
+    fn get_revisions_returns_errors_for_malformed_or_unsupported_main_parts() {
+        let settings = crate::comparer::WmlComparerSettings::default();
+        for body in ["<x:p", "<x:altChunk/>"] {
+            let docx = package(body, &[], "");
+            assert!(crate::document_comparer::get_revisions(&docx, &settings).is_err());
+        }
+        let empty = package("<x:p/>", &[], "");
+        let mut pkg = crate::opc::PartFs::open(&empty).unwrap();
+        for xml in [
+            "",
+            "<x:document xmlns:x='http://schemas.openxmlformats.org/wordprocessingml/2006/main'/>",
+        ] {
+            pkg.set_part("word/document.xml", xml.as_bytes().to_vec());
+            assert!(
+                crate::document_comparer::get_revisions(&pkg.to_zip().unwrap(), &settings).is_err()
+            );
+        }
+        pkg.remove_part("word/document.xml");
+        assert!(
+            crate::document_comparer::get_revisions(&pkg.to_zip().unwrap(), &settings).is_err()
+        );
+    }
+}
