+        let docx = package(
+            "<x:p><x:r><x:t>A</x:t><x:tab/><x:t>B</x:t><x:br/></x:r><x:del><x:r><x:tab/><x:br x:type='page'/></x:r></x:del><x:moveFrom><x:r><x:t>old</x:t></x:r></x:moveFrom><x:ins><x:r><x:t>C</x:t></x:r></x:ins><x:r><x:txbxContent><x:p><x:r><x:t>box</x:t></x:r></x:p></x:txbxContent></x:r></x:p><x:tbl><x:tr><x:tc><x:p><x:r><x:t>cell</x:t><x:br x:type='page'/></x:r></x:p></x:tc></x:tr></x:tbl>",
+            &[],
