+++ b/examples/playground/src/main.js
@@ -0,0 +1,55 @@
+// SPDX-FileCopyrightText: 2026 Jandira Technologies, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+import "./style.css";
+const form=document.querySelector("#task");
+const status=document.querySelector("#status");
+const downloads=document.querySelector("#downloads");
+const preview=document.querySelector("#preview");
+const cancel=document.querySelector("#cancel");
+let worker=null, busy=false, generation=0;
+const urls=[];
+function clearOutputs() {
+  for(const url of urls) URL.revokeObjectURL(url);
+  urls.length=0; downloads.replaceChildren(); preview.removeAttribute("src");preview.hidden=true;
+}
+function setBusy(value) {
+  busy=value;cancel.disabled=!value;
+  for(const button of form.querySelectorAll("button[type=submit]")) button.disabled=value;
+}
+function finish(message) { setBusy(false);status.textContent=message;worker?.terminate();worker=null; }
+function addDownload(data,name,type) {
+  const blob=new Blob([new Uint8Array(data)],{type});const url=URL.createObjectURL(blob);urls.push(url);
+  const link=document.createElement("a");link.href=url;link.download=name;link.textContent=`Download ${name}`;downloads.append(link);
+  return url;
+}
+form.addEventListener("submit",async event=>{
+  event.preventDefault();if(busy)return;
+  const task=event.submitter?.value;
+  const original=document.querySelector("#original").files[0];
+  const modified=document.querySelector("#modified").files[0];
+  const author=document.querySelector("#author").value.trim();
+  if(!original||(task==="compare"&&!modified)){status.textContent="Choose both documents for comparison.";return;}
+  if(task==="compare"&&!author){status.textContent="Enter a revision author.";return;}
+  if([original,modified].filter(Boolean).some(file=>file.size>16*1024*1024)){status.textContent="This demo accepts documents up to 16 MiB each.";return;}
+  clearOutputs();setBusy(true);status.textContent="Processing locally…";
+  const token=++generation;
+  try {
+    const a=await original.arrayBuffer();const b=task==="compare"?await modified.arrayBuffer():null;
+    if(token!==generation)return;
+    worker=new Worker(new URL("./worker.js",import.meta.url),{type:"module"});
+    worker.onmessage=({data})=>{
+      if(token!==generation)return;
+      if(!data.ok){finish(data.error);return;}
+      if(data.redline)addDownload(data.redline,"redline.docx","application/vnd.openxmlformats-officedocument.wordprocessingml.document");
+      preview.src=addDownload(data.pdf,task==="compare"?"redline.pdf":"document.pdf","application/pdf");preview.hidden=false;
+      document.querySelector("#recipe").textContent=task==="compare"
+        ?'from jubarte_redlines import compare_documents, docx_to_pdf\nredline = compare_documents(original_bytes, modified_bytes, author="Reviewer")\npdf = docx_to_pdf(redline, revisions="word")'
+        :'from jubarte_redlines import docx_to_pdf\npdf = docx_to_pdf(docx_bytes)';
+      finish("Complete. Review the preview and download the generated files.");
+    };
+    worker.onerror=()=>{if(token===generation)finish("The worker stopped. Try a smaller or different document.");};
+    worker.postMessage({task,a,b,author},b?[a,b]:[a]);
+  } catch(error) {if(token===generation)finish(`Could not process the document: ${error instanceof Error?error.message:String(error)}`);}
+});
+cancel.addEventListener("click",()=>{generation++;finish("Cancelled. No input file was changed.");});
+window.addEventListener("pagehide",()=>{generation++;worker?.terminate();clearOutputs();});
diff --git a/examples/playground/src/worker.js b/examples/playground/src/worker.js
new file mode 100644
--- /dev/null
+++ b/examples/playground/src/worker.js
@@ -0,0 +1,19 @@
+// SPDX-FileCopyrightText: 2026 Jandira Technologies, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+import init,{compareDocuments,docxToPdf} from "jubarte-wasm/web";
+import wasmUrl from "jubarte-wasm/web/jubarte_wasm_bg.wasm?url";
+self.onmessage=async ({data})=>{
+  try {
+    await init({module_or_path:wasmUrl});
+    if(!(data.a instanceof ArrayBuffer)||!["render","compare"].includes(data.task)) throw new Error("Invalid worker request");
+    let redline;
+    if(data.task==="compare") {
+      if(!(data.b instanceof ArrayBuffer)||typeof data.author!=="string"||!data.author.trim())throw new Error("Invalid comparison inputs");
+      redline=compareDocuments(new Uint8Array(data.a),new Uint8Array(data.b),data.author);
+    }
+    const pdf=docxToPdf(redline??new Uint8Array(data.a),false,data.task==="compare"?"word":"conventional");
+    self.postMessage({ok:true,pdf,redline});
+  } catch(error) {
+    self.postMessage({ok:false,error:`Jubarte could not process this document: ${error instanceof Error?error.message:String(error)}`});
+  }
+};
